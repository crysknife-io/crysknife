<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.crysknife.tests</groupId>
    <artifactId>j2cl-tests</artifactId>
    <version>0.11</version>
    <name>Crysknife :: Tests :: J2CL</name>
    <description>J2CL integration tests</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.deploy.plugin.version>3.0.0-M2</maven.deploy.plugin.version>
        <maven.surefire.plugin.version>3.0.0-M5</maven.surefire.plugin.version>

        <crysknife.version>0.11</crysknife.version>
        <patternfly.version>0.3.0</patternfly.version>
        <j2cl.platform.version>20260527-1</j2cl.platform.version>
        <org.treblereel.j2cl.processors.version>0.11</org.treblereel.j2cl.processors.version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.crysknife</groupId>
                <artifactId>bom</artifactId>
                <version>${crysknife.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.treblereel.j2cl.platform</groupId>
                <artifactId>bom</artifactId>
                <version>${j2cl.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.crysknife</groupId>
            <artifactId>crysknife-core</artifactId>
            <version>${crysknife.version}</version>
        </dependency>
        <dependency>
            <groupId>io.crysknife.ui</groupId>
            <artifactId>crysknife-ui-core</artifactId>
            <version>${crysknife.version}</version>
        </dependency>
        <dependency>
            <groupId>org.patternfly</groupId>
            <artifactId>patternfly-java-components</artifactId>
            <version>${patternfly.version}</version>
        </dependency>
        <dependency>
            <groupId>org.patternfly</groupId>
            <artifactId>patternfly-java-j2cl</artifactId>
            <version>${patternfly.version}</version>
        </dependency>
        <dependency>
            <groupId>org.patternfly</groupId>
            <artifactId>patternfly-java-icons</artifactId>
            <version>${patternfly.version}</version>
        </dependency>
        <dependency>
            <groupId>org.treblereel.j2cl.processors</groupId>
            <artifactId>annotations</artifactId>
            <version>${org.treblereel.j2cl.processors.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.html</include>
                    <include>**/*.css</include>
                    <include>**/*.less</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.crysknife</groupId>
                            <artifactId>crysknife-processor</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife.ui</groupId>
                            <artifactId>crysknife-ui-generator</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife</groupId>
                            <artifactId>crysknife-core</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife.ui</groupId>
                            <artifactId>crysknife-ui-core</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>org.treblereel.j2cl.processors</groupId>
                            <artifactId>processors</artifactId>
                            <version>${org.treblereel.j2cl.processors.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.kie.j2cl.tools</groupId>
                <artifactId>j2cl-maven-plugin</artifactId>
                <version>0.23.8</version>
                <executions>
                    <execution>
                        <id>build-js</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <webappDirectory>${project.build.directory}/gwt/launcherDir/${project.artifactId}/</webappDirectory>
                    <compilationLevel>ADVANCED</compilationLevel>
                    <annotationProcessorMode>IGNORE_MAVEN</annotationProcessorMode>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
