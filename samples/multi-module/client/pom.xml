<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.crysknife.samples</groupId>
        <artifactId>multi-module</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>multi-module-client</artifactId>
    <packaging>jar</packaging>

    <name>Crysknife Sample :: Multi-Module :: Client</name>

    <properties>
        <crysknife.version>0.11</crysknife.version>
        <j2cl.platform.version>20260527-1</j2cl.platform.version>
        <j2cl.processors.version>0.11</j2cl.processors.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.crysknife</groupId>
                <artifactId>bom</artifactId>
                <version>${crysknife.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.treblereel.j2cl.platform</groupId>
                <artifactId>bom</artifactId>
                <version>${j2cl.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.crysknife.samples</groupId>
            <artifactId>multi-module-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.crysknife</groupId>
            <artifactId>crysknife-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.crysknife.ui</groupId>
            <artifactId>crysknife-ui-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.treblereel.j2cl.processors</groupId>
            <artifactId>annotations</artifactId>
            <version>${j2cl.processors.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kie.j2cl.tools</groupId>
            <artifactId>junit-annotations</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kie.j2cl.tools</groupId>
            <artifactId>gwttestcase-emul</artifactId>
            <classifier>sources</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kie.j2cl.tools</groupId>
            <artifactId>junit-emul</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.html</include>
                    <include>**/*.css</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.crysknife</groupId>
                            <artifactId>crysknife-processor</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife.ui</groupId>
                            <artifactId>crysknife-ui-generator</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife</groupId>
                            <artifactId>crysknife-core</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>io.crysknife.ui</groupId>
                            <artifactId>crysknife-ui-core</artifactId>
                            <version>${crysknife.version}</version>
                        </path>
                        <path>
                            <groupId>org.treblereel.j2cl.processors</groupId>
                            <artifactId>processors</artifactId>
                            <version>${j2cl.processors.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.kie.j2cl.tools</groupId>
                <artifactId>j2cl-maven-plugin</artifactId>
                <version>0.23.8</version>
                <executions>
                    <execution>
                        <id>build-js</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>j2cl-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <webdriver>chrome</webdriver>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <webappDirectory>${project.build.directory}/gwt/launcherDir/${project.artifactId}/</webappDirectory>
                    <compilationLevel>ADVANCED</compilationLevel>
                    <annotationProcessorMode>IGNORE_MAVEN</annotationProcessorMode>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
